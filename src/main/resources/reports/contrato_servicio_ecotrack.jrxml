<?xml version="1.0" encoding="UTF-8"?>
<jasperReport
        xmlns="http://jasperreports.sourceforge.net/jasperreports"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
        name="contrato_servicio_ecotrack"
        pageWidth="595"
        pageHeight="842"
        columnWidth="525"
        leftMargin="35"
        rightMargin="35"
        topMargin="35"
        bottomMargin="35"
        whenNoDataType="AllSectionsNoDetail"
        language="java">

    <parameter name="administrador" class="java.lang.String"/>
    <parameter name="cliente" class="java.lang.String"/>
    <parameter name="idSolicitud" class="java.lang.String"/>
    <parameter name="descripcion" class="java.lang.String"/>
    <parameter name="pagoInicial" class="java.math.BigDecimal"/>
    <parameter name="pagoTotal" class="java.math.BigDecimal"/>
    <parameter name="fechaFinalizacion" class="java.lang.String"/>
    <parameter name="firmaAdministrador" class="java.io.InputStream"/>

    <detail>
        <band height="725" splitType="Prevent">

            <!-- ENCABEZADO -->
            <rectangle>
                <reportElement
                        x="0" y="0" width="525" height="82"
                        mode="Opaque"
                        backcolor="#FF3131"/>
                <graphicElement>
                    <pen lineWidth="0"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement
                        x="25" y="15" width="300" height="32"
                        forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="25" isBold="true"/>
                </textElement>
                <text><![CDATA[ECOTRACK]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="27" y="48" width="400" height="18"
                        forecolor="#FFFFFF"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <text><![CDATA[LOGÍSTICA DE RECUPERACIÓN DE RECURSOS]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="360" y="20" width="140" height="30"
                        forecolor="#FFFFFF"/>
                <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[CONSTANCIA DE SERVICIO]]></text>
            </staticText>

            <!-- TÍTULO -->
            <staticText>
                <reportElement
                        x="0" y="105" width="525" height="30"
                        forecolor="#333333"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font fontName="SansSerif" size="17" isBold="true"/>
                </textElement>
                <text><![CDATA[CONTRATO DE PRESTACIÓN DE SERVICIO]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="25" y="145" width="475" height="38"
                        forecolor="#555555"/>
                <textElement
                        textAlignment="Justified"
                        verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <text><![CDATA[Por medio del presente documento, ECOTRACK deja constancia de la prestación del servicio de logística de recuperación de recursos, conforme a la solicitud registrada y a las condiciones acordadas entre las partes.]]></text>
            </staticText>

            <!-- INFORMACIÓN DE LAS PARTES -->
            <rectangle>
                <reportElement
                        x="0" y="200" width="525" height="30"
                        mode="Opaque"
                        backcolor="#FFF0F0"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#FF3131"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement
                        x="12" y="205" width="300" height="20"
                        forecolor="#C92121"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[1. INFORMACIÓN DE LAS PARTES]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="15" y="245" width="140" height="20"
                        forecolor="#555555"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Administrador responsable:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement
                        x="165" y="245" width="345" height="20"
                        forecolor="#333333"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{administrador}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="15" y="271" width="495" height="1" forecolor="#DDDDDD"/>
            </line>

            <staticText>
                <reportElement
                        x="15" y="283" width="140" height="20"
                        forecolor="#555555"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[Cliente:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement
                        x="165" y="283" width="345" height="20"
                        forecolor="#333333"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{cliente}]]></textFieldExpression>
            </textField>

            <line>
                <reportElement x="15" y="309" width="495" height="1" forecolor="#DDDDDD"/>
            </line>

            <staticText>
                <reportElement
                        x="15" y="321" width="140" height="20"
                        forecolor="#555555"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <text><![CDATA[N.º de solicitud:]]></text>
            </staticText>

            <textField isBlankWhenNull="true">
                <reportElement
                        x="165" y="321" width="345" height="20"
                        forecolor="#333333"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{idSolicitud}]]></textFieldExpression>
            </textField>

            <!-- DESCRIPCIÓN -->
            <rectangle>
                <reportElement
                        x="0" y="365" width="525" height="30"
                        mode="Opaque"
                        backcolor="#FFF0F0"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#FF3131"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement
                        x="12" y="370" width="300" height="20"
                        forecolor="#C92121"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[2. DESCRIPCIÓN DEL SERVICIO]]></text>
            </staticText>

            <textField textAdjust="ScaleFont" isBlankWhenNull="true">
                <reportElement
                        x="15" y="408" width="495" height="62"
                        forecolor="#444444"/>
                <textElement
                        textAlignment="Justified"
                        verticalAlignment="Top">
                    <font fontName="SansSerif" size="10"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{descripcion}]]></textFieldExpression>
            </textField>

            <!-- IMPORTE -->
            <rectangle>
                <reportElement
                        x="0" y="490" width="525" height="30"
                        mode="Opaque"
                        backcolor="#FFF0F0"/>
                <graphicElement>
                    <pen lineWidth="0.5" lineColor="#FF3131"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement
                        x="12" y="495" width="300" height="20"
                        forecolor="#C92121"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[3. IMPORTE DEL SERVICIO]]></text>
            </staticText>

            <rectangle>
                <reportElement
                        x="15" y="535" width="495" height="48"
                        mode="Opaque"
                        backcolor="#FAFAFA"/>
                <graphicElement>
                    <pen lineWidth="0.8" lineColor="#DDDDDD"/>
                </graphicElement>
            </rectangle>

            <staticText>
                <reportElement
                        x="30" y="547" width="260" height="22"
                        forecolor="#444444"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="11" isBold="true"/>
                </textElement>
                <text><![CDATA[Importe total del servicio:]]></text>
            </staticText>

            <staticText>
                <reportElement
                        x="320" y="547" width="25" height="22"
                        forecolor="#C92121"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[S/]]></text>
            </staticText>

            <textField pattern="#,##0.00">
                <reportElement
                        x="345" y="547" width="150" height="22"
                        forecolor="#C92121"/>
                <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">
                    <font fontName="SansSerif" size="14" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.math.BigDecimal"><![CDATA[
$P{pagoInicial} == null
    ? ($P{pagoTotal} == null
        ? java.math.BigDecimal.ZERO
        : $P{pagoTotal})
    : ($P{pagoTotal} == null
        ? $P{pagoInicial}
        : $P{pagoInicial}.add($P{pagoTotal}))
                ]]></textFieldExpression>
            </textField>

            <!-- CONSTANCIA -->
            <staticText>
                <reportElement
                        x="15" y="600" width="495" height="42"
                        forecolor="#555555"/>
                <textElement
                        textAlignment="Justified"
                        verticalAlignment="Top">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[En señal de conformidad, se deja constancia de la finalización del servicio asociado a la solicitud indicada en este documento. La información consignada corresponde a los registros del sistema Ecotrack.]]></text>
            </staticText>


            <!-- FIRMA DEL ADMINISTRADOR -->
            <image scaleImage="RetainShape" hAlign="Center" onErrorType="Blank">
                <reportElement
                        x="0"
                        y="645"
                        width="525"
                        height="38"/>
                <imageExpression class="java.io.InputStream"><![CDATA[$P{firmaAdministrador}]]></imageExpression>
            </image>

            <!-- NOMBRE DEL ADMINISTRADOR -->
            <textField isBlankWhenNull="true">
                <reportElement
                        x="0"
                        y="685"
                        width="525"
                        height="18"
                        forecolor="#333333"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font fontName="SansSerif" size="10" isBold="true"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA[$P{administrador}]]></textFieldExpression>
            </textField>

            <!-- CARGO -->
            <staticText>
                <reportElement
                        x="0"
                        y="703"
                        width="525"
                        height="15"
                        forecolor="#777777"/>
                <textElement
                        textAlignment="Center"
                        verticalAlignment="Middle">
                    <font fontName="SansSerif" size="9"/>
                </textElement>
                <text><![CDATA[Administrador de Ecotrack]]></text>
            </staticText>

        </band>
    </detail>

    <pageFooter>
        <band height="25">
            <line>
                <reportElement
                        x="0" y="0" width="525" height="1"
                        forecolor="#FF3131"/>
            </line>

            <staticText>
                <reportElement
                        x="0" y="6" width="400" height="15"
                        forecolor="#888888"/>
                <textElement verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <text><![CDATA[ECOTRACK | Logística de recuperación de recursos]]></text>
            </staticText>

            <textField>
                <reportElement
                        x="430" y="6" width="95" height="15"
                        forecolor="#888888"/>
                <textElement
                        textAlignment="Right"
                        verticalAlignment="Middle">
                    <font fontName="SansSerif" size="8"/>
                </textElement>
                <textFieldExpression class="java.lang.String"><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

</jasperReport>
